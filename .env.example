PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Default XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sca_smart_laundry

# JWT Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# OAuth providers (required for real social sign-in)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Xendit (required for live QRIS/e-wallet invoices)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
